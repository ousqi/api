{
    "openapi": "3.0.0",
    "info": {
        "title": "TTS API",
        "description": "本地环境无需登录即可调试；其他环境使用 Passport 令牌认证。",
        "version": "1.0.0"
    },
    "paths": {
        "/api/tts/voices": {
            "get": {
                "tags": [
                    "TTS"
                ],
                "summary": "获取音色和语速",
                "operationId": "d4ccd879db514260a2610b930c71a1f5",
                "responses": {
                    "200": {
                        "description": "音色和语速列表"
                    },
                    "401": {
                        "description": "未认证"
                    },
                    "429": {
                        "description": "请求过于频繁"
                    }
                }
            }
        },
        "/api/tts/preview": {
            "post": {
                "tags": [
                    "TTS"
                ],
                "summary": "生成试听音频",
                "description": "接口不需要 CSRF token；本地环境无需登录，其他环境需要 Passport 令牌。Azure Speech 未配置时返回 502。",
                "operationId": "aa480bff29859419d0e34f7c2542a00c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "text",
                                    "voice",
                                    "speed"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "example": "apple",
                                        "maxLength": 200
                                    },
                                    "voice": {
                                        "type": "string",
                                        "example": "us_female",
                                        "enum": [
                                            "us_female",
                                            "us_male",
                                            "uk_female"
                                        ]
                                    },
                                    "speed": {
                                        "type": "string",
                                        "example": "normal",
                                        "enum": [
                                            "slow",
                                            "normal",
                                            "fast"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "MP3 音频",
                        "content": {
                            "audio/mpeg": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未认证"
                    },
                    "419": {
                        "description": "CSRF token 无效"
                    },
                    "422": {
                        "description": "请求参数无效"
                    },
                    "429": {
                        "description": "请求过于频繁"
                    },
                    "502": {
                        "description": "语音服务不可用"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "TTS",
            "description": "TTS"
        }
    ]
}